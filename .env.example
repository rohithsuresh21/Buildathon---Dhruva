# Copy to .env.local. Every variable is optional except ORDER_SECRET in production.

# Seals hand-over booking links. At least 16 characters, ideally 32+ random. Generate one:
#   node -e "console.log(require('crypto').randomBytes(36).toString('base64url'))"
ORDER_SECRET=

# Adds Google Places ratings to the agency ranking (Places API (New) must be enabled).
GOOGLE_MAPS_API_KEY=

# Emails the booking confirmation through Resend. RESEND_FROM must be a verified sender.
RESEND_API_KEY=
RESEND_FROM=Dhruva <bookings@example.com>

# Lets a language model polish intake parsing and the written summary. Verdict logic never depends on it.
AI_GATEWAY_API_KEY=
